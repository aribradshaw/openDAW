{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openDAW",
  "version": "0.0.168",
  "identifier": "org.opendaw.studio",
  "build": {
    "beforeDevCommand": "npm run dev:studio",
    "devUrl": "https://localhost:8080",
    "beforeBuildCommand": "npm run build:studio",
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "openDAW Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Free, open-source digital audio workstation",
    "longDescription": "openDAW Studio packaged as an offline desktop application."
  }
}
